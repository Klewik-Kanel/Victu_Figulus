  "_meta": {
    "schema": "packaged/v1",
    "why": "Real days contain Monster and Kurkure. A tracker that only knows dal is a tracker you abandon the first time you eat like a human being. These entries exist so a bad lunch can be logged in four seconds and the rest of the day adjusted around it, rather than left unlogged and invisible.",
    "basis": "Per 100 g (or 100 ml for drinks) from pack labels. Lay's and Monster figures are from Open Food Facts product records read directly from their database; the rest are from pack labels and are good estimates. Scanning a barcode in the app overwrites any of these with that pack's own data, permanently.",
    "packs": "Each item lists the pack sizes actually sold in India, so logging is 'one ₹20 packet', not 'estimate the grams'.",
    "price": "INR per kg/litre, derived from the pack price - so a ₹20 pack of 50 g is ₹400/kg. Correct them in-app like any other price.",
    "nova": "4 means ultra-processed. Shown in the app as a quiet flag, not a scold.",
    "updated": "2026-10-19"
  },

